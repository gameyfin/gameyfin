<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!-- Console, without the output of task runs (it is written to the per-run log files instead) -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <filter class="org.gameyfin.app.core.tasks.logging.NonTaskRunLogFilter"/>
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            <charset>${CONSOLE_LOG_CHARSET}</charset>
        </encoder>
    </appender>

    <!-- Custom File Appender -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>{LOG_FOLDER}/{LOG_FILE_NAME}.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>{LOG_FOLDER}/{LOG_FILE_NAME}.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>{LOG_MAX_HISTORY_DAYS}</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyy-MM-dd'T'HH:mm:ss.SSS} %-5level %-40.40logger{39} : %m%n</pattern>
        </encoder>
    </appender>

    <!-- One log file per task run, see org.gameyfin.app.core.tasks.logging -->
    <appender name="TASK_RUNS" class="ch.qos.logback.classic.sift.SiftingAppender">
        <filter class="org.gameyfin.app.core.tasks.logging.TaskRunLogFilter"/>
        <discriminator>
            <key>taskRunId</key>
            <defaultValue>unknown</defaultValue>
        </discriminator>
        <timeout>5 minutes</timeout>
        <sift>
            <appender name="TASK_RUN-${taskRunId}" class="ch.qos.logback.core.FileAppender">
                <file>{LOG_FOLDER}/tasks/${taskRunId}.log</file>
                <encoder>
                    <pattern>%d{yyy-MM-dd'T'HH:mm:ss.SSS} %-5level %-40.40logger{39} : %m%n</pattern>
                </encoder>
            </appender>
        </sift>
    </appender>

    <!-- Logs every message pushed via websocket on DEBUG, which floods the log -->
    <logger name="com.vaadin.hilla.push" level="INFO"/>

    <logger name="org.gameyfin" level="{LOG_LEVEL_GAMEYFIN}"/>

    <root level="{LOG_LEVEL_ROOT}">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
        <appender-ref ref="TASK_RUNS"/>
    </root>
</configuration>